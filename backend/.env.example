# Optional. Without these, the backend runs in demo mode with simulated data.

# RapidAPI key subscribed to the AeroDataBox API (free "Basic" plan).
AERODATABOX_API_KEY=

# TomTom Routing API key (developer.tomtom.com).
TOMTOM_API_KEY=

# How often to re-poll AeroDataBox, in ms. Keep conservative - free quotas are small.
AERODATABOX_POLL_INTERVAL_MS=600000

PORT=4000
