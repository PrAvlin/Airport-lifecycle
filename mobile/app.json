{
  "expo": {
    "name": "Airport Lifecycle",
    "slug": "airport-lifecycle",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pravlin.airportlifecycle"
    },
    "android": {
      "package": "com.pravlin.airportlifecycle",
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      }
    },
    "plugins": ["expo-notifications"],
    "extra": {
      "apiBaseUrl": "http://localhost:4000"
    }
  }
}
